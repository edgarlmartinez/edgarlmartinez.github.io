---
import Base from '../layouts/Base.astro';
import { site } from '../lib/cv.js';
const residents = site.residents?.url;
---
<Base title={`AI projects · ${site.display_name}`} description="The AI projects have moved to the members-only BIDMC residents site.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="section wrap">
    <h1>AI projects</h1>
    <p style="max-width:720px">The AI projects, their demos and research papers have moved to the members-only site for BIDMC radiology residents and research fellows. Sign in with a BIDMC email to see them.</p>
    {residents && <div class="btns" style="margin-top:20px"><a class="btn btn-primary" href={`${residents}/ai/`}>Residents sign in</a></div>}
  </section>
</Base>
