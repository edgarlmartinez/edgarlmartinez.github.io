---
import Base from '../layouts/Base.astro';
import { site, cases } from '../lib/cv.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = cases.cases || [];
const refs = cases.references || {};
const inRegion = (c, r) => c.region === r || (c.also_in || []).includes(r);
const regions = (cases.regions || []).filter((r) => all.some((c) => c.region === r));
const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const img = (src) => `${base}/cases/${src}`;
const counts = Object.fromEntries((cases.regions || []).map((r) => [r, all.filter((c) => inRegion(c, r)).length]));
// Body map: front-view mannequin. Each region is one or more shapes (paired limbs map to the same region).
// Drawing order matters: chest/thigh first, then the spine and femur strips on top of them.
const E = (cx, cy, rx, ry, rot = 0) => ({ t: 'ellipse', cx, cy, rx, ry, rot });
const R = (x, y, w, h, rx = 8, rot = 0) => ({ t: 'rect', x, y, w, h, rx, rot });
const mirror = (sh) => sh.t === 'ellipse' ? { ...sh, cx: 200 - sh.cx, rot: -sh.rot } : { ...sh, x: 200 - sh.x - sh.w, rot: -sh.rot };
const pair = (sh) => [sh, mirror(sh)];
const BODY = [
  ['Chest', [R(74, 66, 52, 62, 14)]],
  ['Pelvis', [R(72, 166, 56, 34, 14)]],
  ['Shoulder', pair(E(64, 76, 13, 12))],
  ['Humerus', pair(R(50, 88, 15, 56, 7, 8))],
  ['Elbow', pair(E(52, 151, 9, 8))],
  ['Forearm', pair(R(40, 160, 13, 50, 6, 8))],
  ['Wrist', pair(E(40, 216, 8, 6))],
  ['Hand', pair(E(36, 236, 10, 15, 8))],
  ['Hip', pair(E(83, 208, 12, 10))],
  ['Thigh', pair(R(70, 218, 26, 82, 12))],
  ['Femur', pair(R(79, 224, 8, 70, 4))],
  ['Knee', pair(E(84, 312, 12, 10))],
  ['Leg', pair(R(74, 324, 20, 72, 9))],
  ['Ankle', pair(E(84, 404, 9, 7))],
  ['Foot', pair(E(78, 422, 15, 8, -12))],
  ['Cervical spine', [R(93, 50, 14, 16, 5)]],
  ['Thoracic spine', [R(94, 68, 12, 60, 5)]],
  ['Lumbar spine', [R(93, 130, 14, 34, 5)]],
];
const shapeSvg = (sh) => sh.t === 'ellipse'
  ? `<ellipse cx="${sh.cx}" cy="${sh.cy}" rx="${sh.rx}" ry="${sh.ry}"${sh.rot ? ` transform="rotate(${sh.rot} ${sh.cx} ${sh.cy})"` : ''}/>`
  : `<rect x="${sh.x}" y="${sh.y}" width="${sh.w}" height="${sh.h}" rx="${sh.rx}"${sh.rot ? ` transform="rotate(${sh.rot} ${sh.x + sh.w / 2} ${sh.y + sh.h / 2})"` : ''}/>`;
---
<Base title={`Educational cases · ${site.display_name}`} description="Musculoskeletal radiology teaching cases with key images, teaching points and references.">
  <style>
    .case-nav { display:flex; flex-wrap:wrap; gap:8px; margin:18px 0 8px; padding:0; list-style:none; }
    .case-nav a { display:inline-block; border:1px solid var(--line); border-radius:999px; padding:4px 12px; font-size:.9rem; text-decoration:none; color:var(--navy); background:var(--card); }
    .case-nav a:hover { background:var(--bg-soft); }
    .case-nav .n { color:var(--muted); font-size:.8rem; margin-left:4px; }
    .region-h { font-family:var(--serif); color:var(--navy); font-size:1.25rem; margin:36px 0 12px; border-bottom:1px solid var(--line); padding-bottom:4px; scroll-margin-top:80px; }
    .case { border:1px solid var(--line); border-radius:var(--radius); background:var(--card); padding:20px; margin-bottom:18px; display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:22px; scroll-margin-top:80px; }
    .case h3 { margin:0 0 6px; font-size:1.2rem; }
    .case .meta { color:var(--muted); font-size:.875rem; margin-bottom:10px; }
    .case p { margin:0 0 12px; max-width:68ch; }
    .case h4 { font-size:.8rem; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); margin:14px 0 6px; font-family:inherit; }
    .case ul { margin:0; padding-left:20px; display:flex; flex-direction:column; gap:6px; max-width:70ch; }
    .case ol { margin:0; padding-left:22px; font-size:.85rem; color:var(--muted); display:flex; flex-direction:column; gap:4px; }
    .gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:8px; align-content:start; }
    .gallery a { display:flex; flex-direction:column; background:#0b0f14; border-radius:8px; overflow:hidden; text-decoration:none; }
    .gallery img { width:100%; height:180px; object-fit:contain; display:block; }
    .gallery span { color:#d6dde4; font-size:.78rem; padding:5px 8px; background:#121920; }
    @media (max-width:820px) { .case { grid-template-columns:1fr; } }
    .case-top { display:grid; grid-template-columns:220px minmax(0,1fr); gap:28px; align-items:center; margin:18px 0 8px; }
    .bodymap { width:100%; max-width:220px; height:auto; display:block; margin:0 auto; touch-action:manipulation; }
    .bodymap .head { fill:#1a2129; stroke:#2f3944; }
    .bodymap .rg > :global(*) { fill:#1a2129; stroke:#2f3944; stroke-width:1; transition:fill .15s, stroke .15s; }
    .bodymap a.rg > :global(*) { fill:#17404a; stroke:var(--accent); }
    .bodymap a.rg:hover > :global(*), .bodymap a.rg:focus-visible > :global(*) { fill:#2a7d8c; }
    .bodymap a.rg[aria-current='true'] > :global(*) { fill:var(--accent); stroke:#e9f1f8; stroke-width:1.5; }
    .bodymap a.rg:focus { outline:none; }
    .bodymap .tip { font:600 11px/1 system-ui, sans-serif; fill:var(--navy); pointer-events:none; }
    .map-help { color:var(--muted); font-size:.9rem; margin:0 0 10px; }
    .map-status { font-size:.95rem; margin:10px 0 0; min-height:1.6em; }
    .map-status :global(button) { margin-left:8px; font:inherit; font-size:.85rem; color:var(--accent); background:none; border:1px solid var(--line); border-radius:999px; padding:2px 10px; cursor:pointer; }
    .case-nav a[aria-current='true'] { background:var(--accent-soft); border-color:var(--accent); }
    .case-nav a.off { color:var(--muted); opacity:.55; pointer-events:none; }
    [hidden] { display:none !important; }
    @media (max-width:640px) { .case-top { grid-template-columns:1fr; gap:12px; } .bodymap { max-width:160px; } }
  </style>
  <section class="section wrap">
    <h1>Educational cases</h1>
    <p style="max-width:720px">Musculoskeletal radiology teaching cases, organized by body region, each with key images, teaching points and references.</p>
    <p class="card" style="max-width:720px;background:var(--bg-soft)"><b>For education only.</b> Images are de-identified: burned-in text, initials and scanner labels were removed, and every image was resampled, intensity-normalized and re-encoded so no original pixel data or metadata remains. Exact study dates are omitted. Not for clinical decision-making.</p>
    <div class="case-top">
      <svg class="bodymap" viewBox="10 0 180 440" role="group" aria-label="Body map: choose a region to filter cases">
        <circle class="head" cx="100" cy="28" r="20" aria-hidden="true" />
        <rect class="head" x="78" y="124" width="44" height="46" rx="12" aria-hidden="true" />
        {BODY.map(([r, shapes]) => counts[r]
          ? <a class="rg" href={`#${slug(r)}`} data-region={r} aria-label={`${r}: ${counts[r]} case${counts[r] > 1 ? 's' : ''}`}><title>{`${r} (${counts[r]})`}</title><Fragment set:html={shapes.map(shapeSvg).join('')} /></a>
          : <g class="rg" aria-hidden="true"><title>{`${r}: no cases yet`}</title><Fragment set:html={shapes.map(shapeSvg).join('')} /></g>)}
      </svg>
      <div>
        <p class="map-help">Tap a highlighted part of the body to see its cases, or pick a region from the list.</p>
        <ul class="case-nav" aria-label="Regions">
          {(cases.regions || []).filter((r) => counts[r]).map((r) => <li><a href={`#${slug(r)}`} data-region={r}>{r}<span class="n">{counts[r]}</span></a></li>)}
        </ul>
        <p class="map-status" aria-live="polite"></p>
      </div>
    </div>
    {regions.map((r) => (
      <div class="region-sec">
        <h2 class="region-h" id={slug(r)}>{r}</h2>
        {all.filter((c) => c.region === r).map((c) => (
          <article class="case" id={c.id} data-regions={[c.region, ...(c.also_in || [])].join("|")}>
            <div>
              <h3>{c.title}</h3>
              <div class="meta">{[c.region, ...(c.also_in || [])].join(' · ')} · {c.modality}</div>
              <p>{c.findings}</p>
              {c.toolkit_link && <p><a class="btn btn-outline" href={`${base}/${c.toolkit_link.href}`}>{c.toolkit_link.label}</a></p>}
              <h4>Teaching points</h4>
              <ul>{c.teaching.map((t) => <li>{t}</li>)}</ul>
              <h4>References</h4>
              <ol>{c.refs.filter((k) => refs[k]).map((k) => <li><a href={refs[k].url} target="_blank" rel="noopener">{refs[k].citation}</a></li>)}</ol>
            </div>
            <div class="gallery">
              {c.images.map((im) => (
                <a href={img(im.src)} target="_blank" rel="noopener"><img src={img(im.src)} alt={im.caption} loading="lazy" /><span>{im.caption}</span></a>
              ))}
            </div>
          </article>
        ))}
      </div>
    ))}
  </section>
  <script is:inline>
  (() => {
    const links = [...document.querySelectorAll('[data-region]')];
    const arts = [...document.querySelectorAll('article.case')];
    const secs = [...document.querySelectorAll('.region-sec')];
    const status = document.querySelector('.map-status');
    const nameOf = Object.fromEntries(links.map((a) => [a.getAttribute('href').slice(1), a.dataset.region]));
    const apply = (region, scroll) => {
      links.forEach((a) => a.setAttribute('aria-current', a.dataset.region === region ? 'true' : 'false'));
      arts.forEach((el) => { el.hidden = !!region && !el.dataset.regions.split('|').includes(region); });
      secs.forEach((s) => { s.hidden = !!region && !s.querySelector('article.case:not([hidden])'); });
      const n = arts.filter((el) => !el.hidden).length;
      status.innerHTML = region ? `Showing <b>${region}</b>: ${n} case${n === 1 ? '' : 's'} <button type="button">Show all</button>` : '';
      const b = status.querySelector('button'); if (b) b.onclick = () => { history.replaceState(null, '', location.pathname); apply(null); };
      if (region && scroll) status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };
    links.forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      const r = a.dataset.region, on = a.getAttribute('aria-current') === 'true';
      history.replaceState(null, '', on ? location.pathname : a.getAttribute('href'));
      apply(on ? null : r, true);
    }));
    const fromHash = () => { const h = decodeURIComponent(location.hash.slice(1)); if (nameOf[h]) apply(nameOf[h]); else if (!h) apply(null); };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  })();
  </script>
</Base>
