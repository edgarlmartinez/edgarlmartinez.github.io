---
import Base from '../layouts/Base.astro';
import { site } from '../lib/cv.js';
const residents = site.residents?.url;
---
<Base title={`Lectures · ${site.display_name}`} description="The lecture library has moved to the members-only BIDMC residents site.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="section wrap">
    <h1>Lectures</h1>
    <p style="max-width:720px">The lecture library has moved to the members-only site for BIDMC radiology residents and fellows. Sign in with a BIDMC email to see it.</p>
    {residents && <div class="btns" style="margin-top:20px"><a class="btn btn-primary" href={`${residents}/lectures/`}>Residents sign in</a></div>}
  </section>
</Base>
