---
import Base from '../layouts/Base.astro';
import { cv, site, newest, isCurrent, lectures } from '../lib/cv.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentRoles = newest(cv.faculty_academic_appointments).filter(isCurrent).map((a) => a.title);
const links = Object.entries(site.links || {}).filter(([k, v]) => v && k !== 'email');
const linkLabels = { bidmc_profile: 'BIDMC', harvard_catalyst: 'Harvard Catalyst', pubmed: 'PubMed', google_scholar: 'Google Scholar', orcid: 'ORCID', linkedin: 'LinkedIn', x: 'X' };

// Toolkit sections (kept in sync by hand with /toolkit/ tabs).
const toolkitSections = ['Spine and scoliosis', 'Craniocervical junction', 'Chemical shift', 'Shoulder', 'Pelvis and hip', 'Knee', 'Wrist', 'Foot and ankle', 'Pediatric foot'];


const lectureList = newest((lectures.lectures || []).map((l) => ({ ...l, start: l.date })));
---
<Base>
  <div class="home wrap">
    <aside class="side">
      {site.photo && <img class="side-photo" src={`${base}/${site.photo}`} alt={`Portrait of ${site.display_name}`} width="220" height="220" />}
      <h1>{site.display_name}</h1>
      <p class="side-headline">{site.headline}</p>
      <ul class="side-roles">{currentRoles.map((r) => <li>{r}</li>)}</ul>
      <div class="side-btns">
        <a class="btn btn-primary" href={`${base}/cv/`}>View CV</a>
        <a class="btn btn-outline" href={`${base}/cv.pdf`} download="Martinez-Salazar_HMS_CV.pdf">Download CV (PDF)</a>
        <a class="btn btn-outline" href={`${base}/publications/`}>Publications</a>
      </div>
      {site.links?.email && <p class="side-contact"><a href={`mailto:${site.links.email}`}>{site.links.email}</a></p>}
      <p class="side-links">{links.map(([k, v], i) => <>{i > 0 && ' · '}<a href={v} target="_blank" rel="noopener">{linkLabels[k] || k}</a></>)}</p>
    </aside>

    <div class="main">
      <section class="feature">
        <div class="feature-head">
          <div>
            <p class="eyebrow">Measurement toolkit</p>
            <h2>MSK Measurement Toolkit</h2>
          </div>
          <a class="btn btn-primary" href={`${base}/toolkit/`}>Open the toolkit →</a>
        </div>
        <p>Literature-based normal values, grading and interpretation for common musculoskeletal measurements. Measure directly on your own image with guided landmarks, then check yourself against practice cases with answer keys. Every threshold links to its source.</p>
        <ul class="tags">{toolkitSections.map((s) => <li>{s}</li>)}</ul>
        <p class="meta" style="margin-top:12px">Works offline in the browser. Images you load never leave your computer. For research and education only.</p>
      </section>

      {site.residents?.url && (
        <section class="feature">
          <div class="feature-head">
            <div>
              <p class="eyebrow">For BIDMC residents</p>
              <h2>Teaching cases and the Core MSK book</h2>
            </div>
            <a class="btn btn-primary" href={site.residents.url}>Residents sign in →</a>
          </div>
          <p>De-identified musculoskeletal teaching cases, organized by body region, and the Core MSK Radiology book are available to BIDMC radiology trainees. Sign in with your @bidmc.harvard.edu email; you'll get a one-time code by email.</p>
        </section>
      )}

      <section class="feature">
        <div class="feature-head">
          <div>
            <p class="eyebrow">Lectures</p>
            <h2>Lecture library</h2>
          </div>
          <a class="btn btn-primary" href={`${base}/lectures/`}>All lectures →</a>
        </div>
        <p>For residents and fellows. Slides are shared only with invited trainees.</p>
        <ul class="lecture-list">
          {lectureList.map((l) => (
            <li>
              <div>
                <span class="lecture-title">{l.title}</span>
                <span class="meta">{l.date} · {l.audience}</span>
              </div>
              {(l.link || lectures.folder_link) && <a class="btn btn-outline" href={l.link || lectures.folder_link} target="_blank" rel="noopener">Slides ↗</a>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .home { display: grid; grid-template-columns: minmax(240px, 1fr) 3fr; gap: 40px; align-items: start; padding-top: 40px; max-width: 1280px; }
  .side { position: sticky; top: 84px; text-align: left; }
  .side-photo { width: 100%; max-width: 220px; height: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover; border: 3px solid #2a3440; display: block; margin-bottom: 18px; }
  .side h1 { font-size: 1.6rem; margin: 0 0 6px; color: #fff; }
  .side-headline { color: var(--accent); margin: 0 0 14px; font-weight: 500; }
  .side-roles { list-style: none; padding: 0; margin: 0 0 20px; font-size: .88rem; color: var(--muted); }
  .side-roles li { padding: 6px 0; border-top: 1px solid var(--line); }
  .side-btns { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
  .side-btns .btn { text-align: center; }
  .side-contact { font-size: .88rem; margin: 0 0 6px; word-break: break-all; }
  .side-links { font-size: .85rem; color: var(--muted); line-height: 1.8; margin: 0; }
  .main { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .feature { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px 26px; }
  .feature-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; }
  .feature h2 { margin: 0; font-size: 1.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .72rem; color: var(--accent); margin: 0 0 4px; font-weight: 600; }
  .feature > p { color: #c9d3de; margin: 8px 0 14px; max-width: 760px; }
  .lecture-list { list-style: none; padding: 0; margin: 0; }
  .lecture-list li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); }
  .lecture-title { display: block; font-weight: 500; }
  @media (max-width: 900px) {
    .home { grid-template-columns: 1fr; gap: 28px; }
    .side { position: static; text-align: center; }
    .side-photo { margin: 0 auto 16px; max-width: 160px; }
    .side-btns { max-width: 320px; margin-left: auto; margin-right: auto; }
  }
</style>
