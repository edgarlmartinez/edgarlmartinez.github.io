---
import Base from '../layouts/Base.astro';
import { site } from '../lib/cv.js';
const c = site.consulting || {};
---
<Base title={`Expert consultation · ${site.display_name}`} description="Independent expert consultation in musculoskeletal radiology for legal and professional matters.">
  {!c.enabled && <meta slot="head" name="robots" content="noindex, nofollow" />}
  <section class="section wrap" style="max-width:820px">
    {!c.enabled && <p class="card" style="background:#fff7e6;border-color:#f0d9a8"><b>Preview only.</b> This page is hidden from the menu and search engines until <code>consulting.enabled</code> is set to true.</p>}
    <h1>Expert consultation</h1>
    <p>Dr. Martinez Salazar accepts a limited number of requests for independent expert consultation in musculoskeletal radiology. Typical matters include:</p>
    <ul>
      <li>Medicolegal review of musculoskeletal imaging (personal injury, workers' compensation, professional liability)</li>
      <li>Expert opinion and written reports on imaging findings in sports and orthopedic injuries</li>
      <li>Imaging consultation for attorneys, insurers and other professional organizations</li>
    </ul>

    <h2>How it works</h2>
    <ol>
      <li><b>Send a brief inquiry</b> with the type of matter, the requesting party, the deadline and your contact details.</li>
      <li><b>Review before acceptance.</b> Every request is screened for conflicts of interest and reviewed under applicable institutional policies before any engagement is accepted.</li>
      <li><b>Engagement letter.</b> If the request can be accepted, scope, timeline and fees are set out in a written engagement agreement. Work begins only after it is signed.</li>
    </ol>

    <div class="card" style="margin:24px 0">
      <h3>Before you submit</h3>
      <ul style="margin:0;padding-left:20px">
        <li><b>Do not send images, medical records or any patient-identifying information</b> with your inquiry. Materials are requested only after an engagement is accepted.</li>
        <li>Submitting an inquiry does not create an engagement, an attorney-client or physician-patient relationship, or any obligation to provide an opinion.</li>
        <li>This service does not provide medical care, diagnosis or treatment advice to individuals. For a medical concern, please contact your own physician.</li>
        <li>Consultations are provided in an individual capacity and not on behalf of Beth Israel Deaconess Medical Center or Harvard Medical School.</li>
      </ul>
    </div>

    {c.form_url
      ? <a class="btn btn-outline" style="background:var(--navy);color:#fff" href={c.form_url} target="_blank" rel="noopener">Submit an inquiry ↗</a>
      : <p class="meta">The inquiry form will be available soon.</p>}
  </section>
</Base>
