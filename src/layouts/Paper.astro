---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${frontmatter.short} · AI projects`} description={frontmatter.description}>
  <section class="section wrap">
    <p class="meta"><a href={`${base}/ai/`}>← AI projects</a></p>
    <article class="methods paper card">
      <p class="paper-badge">Preprint draft · not peer reviewed · {frontmatter.updated}</p>
      <h1>{frontmatter.title}</h1>
      <p class="meta">{frontmatter.authors}</p>
      <slot />
    </article>
  </section>
</Base>
