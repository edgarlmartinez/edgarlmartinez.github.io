---
import '../styles/global.css';
import { site, aiProjects, cases } from '../lib/cv.js';
const { title = site.display_name, description = `${site.display_name}, ${site.headline}. ${site.affiliation}.`, bodyClass = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <header class="site-header no-print">
      <div class="wrap header-inner">
        <a class="brand" href={`${base}/`}>{site.display_name}</a>
        <nav>
          <a href={`${base}/`} aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <a href={`${base}/publications/`} aria-current={path.startsWith('/publications') ? 'page' : undefined}>Publications</a>
          <a href={`${base}/toolkit/`}>Measurement toolkit</a>
          {aiProjects.length > 0 && <a href={`${base}/ai/`} aria-current={path.startsWith('/ai') ? 'page' : undefined}>AI projects</a>}
          {cases.cases?.length > 0 && <a href={`${base}/cases/`} aria-current={path.startsWith('/cases') ? 'page' : undefined}>Educational cases</a>}
          <a href={`${base}/lectures/`} aria-current={path.startsWith('/lectures') ? 'page' : undefined}>Lectures</a>
          {site.consulting?.enabled && <a href={`${base}/consulting/`} aria-current={path.startsWith('/consulting') ? 'page' : undefined}>Consulting</a>}
          <a href={`${base}/cv/`} aria-current={path.startsWith('/cv') ? 'page' : undefined}>CV</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer no-print">
      <div class="wrap">© {new Date().getFullYear()} {site.display_name} · {site.affiliation}</div>
    </footer>
  </body>
</html>
